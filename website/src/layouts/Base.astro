---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../../../assets/UnishadeSmall.png';
import icon from '../../../assets/Unishade.ico?url';
import banner from '../../../assets/unishade-banner1.png';
import { links } from '../links';
import BookIcon from '../icons/book.svg';
import DiscordIcon from '../icons/discord.svg';
import GithubIcon from '../icons/github.svg';
import KofiIcon from '../icons/kofi.svg';

interface Props {
  title: string;
  description: string;
  // The home page lays its navigation over the picture.
  overlay?: boolean;
}

const { title, description, overlay = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0f1024" />
    <link rel="icon" href={icon} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(banner.src, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class:list={['nav', { overlay }]}>
      <a class="brand" href="/" aria-label="Unishade home">
        <Image src={logo} alt="" width={52} class="brand-logo" />
        <span class="brand-name">Unishade</span>
      </a>
      <nav aria-label="Main">
        <a href="/docs/"><BookIcon aria-hidden="true" />Docs</a>
        <a href={links.discord}><DiscordIcon aria-hidden="true" />Discord</a>
        <a href={links.github}><GithubIcon aria-hidden="true" />GitHub</a>
        <a class="kofi" href={links.kofi}><KofiIcon aria-hidden="true" />Ko-fi</a>
        <a class="button button-primary" href="/download/">Download</a>
      </nav>
    </header>

    <script>
      const nav = document.querySelector('.nav')!;
      const update = () => nav.classList.toggle('scrolled', window.scrollY > 0);
      addEventListener('scroll', update, { passive: true });
      update();
    </script>

    <slot />

    <footer class="footer">
      <div class="footer-inner">
        <p>
          Need help? Ask on <a href={links.discord}>Discord</a>. Only the newest version is supported, and updating keeps your presets.
        </p>
        <p>Unishade is free. You can support it on <a href={links.kofi}>Ko-fi</a>.</p>
        <p class="dim">
          Effects run on <a href={links.reshade}>ReShade</a> by crosire. Unishade isn't affiliated with the games it runs on.{' '}
          <a href={links.github}>Source on GitHub</a>, <a href={links.license}>MIT license</a>.
        </p>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Spans the window so the background does too, with the links on the page's edges. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--nav-height);
    padding: 0 calc((100% - var(--page)) / 2);
    transition: background-color 0.2s, box-shadow 0.2s;
  }

  .nav.overlay {
    position: fixed;
    inset: 0 0 auto;
    background-image: linear-gradient(to bottom, rgb(15 16 36 / 0.7), transparent);
  }

  .nav.scrolled {
    box-shadow: 0 1px 0 var(--line);
    background-color: rgb(15 16 36 / 0.8);
    backdrop-filter: blur(16px);
  }

  .nav .button {
    min-height: 40px;
    padding: 0 18px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-weight: 750;
    font-stretch: 118%;
    text-decoration: none;
  }

  .brand-logo {
    width: 40px;
    height: auto;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  nav a:not(.button) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    text-decoration: none;
  }

  nav svg {
    width: 20px;
    height: 20px;
  }

  .kofi svg {
    color: #ff5e5b;
  }

  nav a:not(.button):hover {
    color: var(--accent);
  }

  .footer {
    margin-top: clamp(80px, 12vw, 140px);
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    display: grid;
    gap: 10px;
    width: var(--page);
    margin: 0 auto;
    padding: 36px 0 48px;
  }

  @media (max-width: 780px) {
    nav a:not(.button) {
      display: none;
    }
  }

  @media (max-width: 440px) {
    .brand-name {
      display: none;
    }
  }
</style>
