---
import '../styles/global.css';
import { Image } from 'astro:assets';
import logo from '../../../assets/UnishadeSmall.png';
import icon from '../../../assets/Unishade.ico?url';
import banner from '../../../assets/unishade-banner1.png';
import { links } from '../links';
import BookIcon from '../icons/book.svg';
import DiscordIcon from '../icons/discord.svg';
import GithubIcon from '../icons/github.svg';
import KofiIcon from '../icons/kofi.svg';

interface Props {
  title: string;
  description: string;
  // The home page lays its navigation over the picture.
  overlay?: boolean;
}

const { title, description, overlay = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#0f1024" />
    <link rel="icon" href={icon} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(banner.src, Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class:list={['nav', { overlay }]}>
      <a class="brand" href="/" aria-label="Unishade home">
        <Image src={logo} alt="" width={52} class="brand-logo" />
        <span class="brand-name">Unishade</span>
      </a>
      <nav aria-label="Main">
        <a href="/docs/"><BookIcon aria-hidden="true" />Docs</a>
        <a href={links.discord}><DiscordIcon aria-hidden="true" />Discord</a>
        <a href={links.github}><GithubIcon aria-hidden="true" />GitHub</a>
        <a class="kofi" href={links.kofi}><KofiIcon aria-hidden="true" />Ko-fi</a>
        <a class="button button-primary" href="/download/">Download</a>
      </nav>
    </header>

    <script>
      const nav = document.querySelector('.nav')!;
      const update = () => nav.classList.toggle('scrolled', window.scrollY > 0);
      addEventListener('scroll', update, { passive: true });
      update();
    </script>

    <slot />

    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-about">
          <a class="brand" href="/">
            <Image src={logo} alt="" width={52} class="brand-logo" />
            Unishade
          </a>
          <p class="dim">ReShade effects for games where ReShade can't run. Free and open source.</p>
        </div>
        <div class="footer-links">
          <div>
            <h2>Unishade</h2>
            <ul>
              <li><a href="/download/">Download</a></li>
              <li><a href="/docs/">Docs</a></li>
              <li><a href="/docs/troubleshooting/">Troubleshooting</a></li>
              <li><a href={links.releases}>Releases</a></li>
            </ul>
          </div>
          <div>
            <h2>Community</h2>
            <ul>
              <li><a href={links.discord}>Discord</a></li>
              <li><a href={links.github}>GitHub</a></li>
              <li><a href={links.kofi}>Ko-fi</a></li>
            </ul>
          </div>
          <div>
            <h2>Legal</h2>
            <ul>
              <li><a href="/terms/">Terms</a></li>
              <li><a href="/privacy/">Privacy</a></li>
              <li><a href="/cookies/">Cookies</a></li>
              <li><a href={links.license}>MIT license</a></li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom dim">
          <p>© {new Date().getFullYear()} Unishade contributors</p>
          <p>
            Effects run on <a href={links.reshade}>ReShade</a> by crosire. Unishade isn't affiliated with the games it runs on.
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  /* Spans the window so the background does too, with the links on the page's edges. */
  .nav {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    height: var(--nav-height);
    padding: 0 calc((100% - var(--page)) / 2);
    transition: background-color 0.2s, box-shadow 0.2s;
  }

  .nav.overlay {
    position: fixed;
    inset: 0 0 auto;
    background-image: linear-gradient(to bottom, rgb(15 16 36 / 0.7), transparent);
  }

  .nav.scrolled {
    box-shadow: 0 1px 0 var(--line);
    background-color: rgb(15 16 36 / 0.8);
    backdrop-filter: blur(16px);
  }

  .nav .button {
    min-height: 40px;
    padding: 0 18px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: var(--ink);
    font-weight: 750;
    font-stretch: 118%;
    text-decoration: none;
  }

  .brand-logo {
    width: 40px;
    height: auto;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 26px;
  }

  nav a:not(.button) {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--ink);
    text-decoration: none;
  }

  nav svg {
    width: 20px;
    height: 20px;
  }

  .kofi svg {
    color: #ff5e5b;
  }

  nav a:not(.button):hover {
    color: var(--accent);
  }

  .footer {
    margin-top: clamp(80px, 12vw, 140px);
    border-top: 1px solid var(--line);
  }

  .footer-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 48px clamp(32px, 6vw, 96px);
    width: var(--page);
    margin: 0 auto;
    padding: 56px 0 40px;
  }

  .footer-about {
    display: grid;
    gap: 14px;
    align-content: start;
    justify-items: start;
    max-width: 30ch;
  }

  .footer-links {
    display: grid;
    grid-template-columns: repeat(3, auto);
    gap: 32px clamp(40px, 6vw, 88px);
  }

  .footer-links h2 {
    margin-bottom: 14px;
    color: var(--haze);
    font-size: 0.9rem;
    font-weight: 600;
    font-stretch: 100%;
    letter-spacing: 0;
  }

  .footer-links ul {
    display: grid;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .footer-links a {
    color: var(--ink);
    text-decoration: none;
  }

  .footer-links a:hover {
    color: var(--accent);
  }

  .footer-bottom {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 8px 24px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
    font-size: 0.9rem;
  }

  @media (max-width: 780px) {
    nav a:not(.button) {
      display: none;
    }

    .footer-inner {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 440px) {
    .brand-name {
      display: none;
    }

    .footer-links {
      grid-template-columns: repeat(2, auto);
    }
  }
</style>
