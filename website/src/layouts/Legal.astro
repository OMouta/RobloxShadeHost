---
import Base from './Base.astro';

// The Markdown pages in src/pages that use this layout pass their frontmatter.
interface Props {
  frontmatter: { title: string; description: string; updated: string };
}

const { frontmatter } = Astro.props;
---

<Base title={`${frontmatter.title} | Unishade`} description={frontmatter.description}>
  <main class="legal prose">
    <h1>{frontmatter.title}</h1>
    <p class="dim updated">Last updated {frontmatter.updated}</p>
    <slot />
  </main>
</Base>

<style>
  .legal {
    width: var(--page);
    margin: clamp(40px, 7vw, 80px) auto 0;
  }

  .legal h1 {
    margin-bottom: 12px;
  }

  .legal .updated {
    margin-bottom: 40px;
  }
</style>
