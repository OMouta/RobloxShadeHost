---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';

// Addresses on the site for the guides in the repository.
const guides = {
  docs: { id: 'installation', title: 'Install Unishade', description: 'Install Unishade with Setup, choose your game window, and open the menu.' },
  dlss5: { id: 'dlss5-readme', title: 'DLSS5 setup', description: 'Get Unishade running DLSS5 on your NVIDIA RTX card.' },
};

export function getStaticPaths() {
  return [{ params: { guide: 'docs' } }, { params: { guide: 'dlss5' } }];
}

const guide = guides[Astro.params.guide as keyof typeof guides];
const entry = await getEntry('guides', guide.id);
if (!entry) throw new Error(`The ${guide.id} guide is missing.`);
const { Content } = await render(entry);
---

<Base title={`${guide.title} | Unishade`} description={guide.description}>
  <main class="guide">
    <Content />
  </main>
</Base>

<style>
  .guide {
    width: min(720px, 100% - 2 * var(--gutter));
    margin: clamp(40px, 7vw, 80px) auto 0;
  }

  .guide :global(h1) {
    margin-bottom: 28px;
    font-size: clamp(2.1rem, 4.4vw, 3.2rem);
  }

  .guide :global(h2) {
    margin: 64px 0 18px;
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  .guide :global(p),
  .guide :global(ul),
  .guide :global(ol) {
    margin: 0 0 16px;
    max-width: 68ch;
  }

  .guide :global(li) {
    margin-bottom: 6px;
  }

  .guide :global(li::marker) {
    color: var(--accent);
  }

  .guide :global(img) {
    margin: 26px 0 8px;
    border: 1px solid var(--line);
    border-radius: var(--radius);
  }

  .guide :global(code) {
    padding: 2px 6px;
    border-radius: 6px;
    font-size: 0.92em;
    background: var(--night-raised);
  }
</style>
