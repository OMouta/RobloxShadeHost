---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import DownloadButton from '../components/DownloadButton.astro';
import banner from '../../../assets/unishade-banner.png';
import menu from '../assets/menu-effects-crop.jpg';
import launcher from '../content/docs/images/launcher.png';
import setup from '../content/docs/images/setup-addons.png';
---

<Base
  title="Unishade | Universal post-processing without injection."
  description="Use ReShade on games that won't let you install it. Every official effect, ready-made presets and a menu right over the game."
  overlay
>
  <main>
    <section class="hero">
      <div class="stage">
        <Image src={banner} widths={[900, 1800]} sizes="100vw" alt="Six games with Unishade effects" class="banner" loading="eager" />
      </div>
      <div class="lede">
        <h1>Universal post-processing without injection.</h1>
        <p>Use ReShade on games that won't let you install it. Formerly RobloxShadeHost.</p>
        <DownloadButton />
      </div>
    </section>

    <section class="games">
      <div class="games-text">
        <h2>Add your game in two clicks</h2>
        <p>Open your game, click Add game and pick its window. Next time you play, your effects are already on.</p>
        <p class="dim">Works with games in windowed or borderless mode.</p>
        <a href="/docs/games/">More about games</a>
      </div>
      <Image src={launcher} widths={[620, 1240]} sizes="(max-width: 900px) 100vw, 620px" alt="The Unishade window with three saved games" class="shot" />
    </section>

    <section class="menu">
      <div class="menu-text">
        <h2>Press Home and pick a look</h2>
        <p>The menu opens right over the game. Switch presets, turn effects on and tweak them while you watch.</p>
        <ul>
          <li>Save your own presets or import shared ones</li>
          <li>Every ReShade effect, searchable</li>
          <li>Hold F7 to compare with the original</li>
          <li>Before and after screenshots from the same frame</li>
        </ul>
      </div>
      <Image src={menu} widths={[640, 900]} sizes="(max-width: 900px) 100vw, 60vw" alt="The Unishade menu with an effect's settings open" class="shot" />
    </section>

    <section class="install">
      <div class="install-text">
        <h2>One installer, a few minutes</h2>
        <p>Setup brings ReShade, every official effect and a set of presets. Depth estimation and DLSS5 are there if you want them.</p>
        <ol>
          <li>Download Setup and run it.</li>
          <li>Pick your add-ons.</li>
          <li>Open your game and add it in Unishade.</li>
          <li>Press Home in the game.</li>
        </ol>
        <DownloadButton />
        <a href="/docs/">Read the install guide</a>
      </div>
      <Image src={setup} widths={[900, 1800]} sizes="(max-width: 900px) 100vw, 55vw" alt="Setup's add-ons page" class="shot" />
    </section>
  </main>
</Base>

<style>
  /* The picture stays clear of text. The headline sits under it. */
  .stage {
    position: relative;
    height: clamp(320px, 55svh, 640px);
  }

  .banner {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Fades the picture into the page above the headline. */
  .stage::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 35%;
    background: linear-gradient(to bottom, transparent, var(--night));
  }

  .lede {
    display: grid;
    gap: 24px;
    width: var(--page);
    margin: clamp(28px, 4vw, 44px) auto 0;
  }

  .lede h1 {
    max-width: 24ch;
    font-size: clamp(1.9rem, 3.9vw, 3.5rem);
  }

  section:not(.hero) {
    width: var(--page);
    margin: clamp(96px, 13vw, 160px) auto 0;
  }

  .games,
  .menu,
  .install {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 8fr);
    gap: clamp(32px, 5vw, 64px);
    align-items: center;
  }

  /* The launcher is a small window, so it gets less room than the text. */
  .games {
    grid-template-columns: minmax(0, 1fr) minmax(0, 620px);
  }

  .games-text,
  .menu-text,
  .install-text {
    display: grid;
    gap: 20px;
    justify-items: start;
    max-width: 42ch;
  }

  .menu-text ul {
    display: grid;
    gap: 8px;
    margin: 0;
    padding-left: 1.2em;
  }

  .menu-text li::marker {
    color: var(--accent);
  }

  .install ol {
    display: grid;
    gap: 10px;
    margin: 0;
    padding-left: 1.4em;
  }

  .install li::marker {
    color: var(--accent);
    font-weight: 700;
  }

  .shot {
    width: 100%;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }

  @media (max-width: 900px) {
    .games,
    .menu,
    .install {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
